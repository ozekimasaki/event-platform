---
import DashboardLayout from '../../layout.astro';
import Button from '../../../../components/ui/Button.astro';
import Input from '../../../../components/ui/Input.astro';
import BlogEditor from '../../../../components/BlogEditor';

const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';
const token = Astro.cookies.get('sb-token')?.value || '';

const { id } = Astro.params;

const breadcrumbs = [
  { label: '記事管理', href: '/dashboard/articles' },
  { label: '記事編集' },
];

interface Article {
  id: string;
  title: string;
  slug: string;
  content: string;
  excerpt: string | null;
  cover_image_url: string | null;
  published_at: string | null;
  created_at: string;
  updated_at: string | null;
  status: string;
}

let article: Article | null = null;
let loadError = '';

try {
  const res = await fetch(`${API_BASE}/api/articles/by-id/${id}`, {
    headers: { 'Authorization': `Bearer ${token}` },
  });
  if (res.ok) {
    const json = await res.json();
    article = json.data;
  } else if (res.status === 404) {
    loadError = '記事が見つかりませんでした';
  } else if (res.status === 403) {
    loadError = 'この記事を編集する権限がありません';
  } else {
    loadError = '記事の読み込みに失敗しました';
  }
} catch (err) {
  console.error('Failed to fetch article:', err);
  loadError = 'ネットワークエラーが発生しました';
}

const formatDateForInput = (dateStr: string | null): string => {
  if (!dateStr) return '';
  const d = new Date(dateStr);
  const pad = (n: number) => String(n).padStart(2, '0');
  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
};

const getStatus = (article: Article): string => {
  if (!article.published_at) return 'draft';
  const pubDate = new Date(article.published_at);
  if (pubDate > new Date()) return 'scheduled';
  return 'published';
};
---

<DashboardLayout title="記事編集" {breadcrumbs}>
  <div class="max-w-3xl">
    <h1 class="heading-lg text-text-primary mb-6">記事編集</h1>

    {loadError ? (
      <div class="text-center py-16 border border-border-default rounded-md">
        <p class="heading-sm text-danger mb-2">{loadError}</p>
        <Button variant="secondary" href="/dashboard/articles">記事一覧に戻る</Button>
      </div>
    ) : article ? (
      <form id="article-form" class="flex flex-col gap-6">
        <input type="hidden" name="article_id" value={article.id} />

        <!-- Title -->
        <Input
          label="タイトル *"
          name="title"
          id="title"
          placeholder="記事のタイトルを入力してください"
          value={article.title}
          required
        />

        <!-- Slug -->
        <div class="flex flex-col gap-1.5">
          <label for="slug" class="text-sm font-medium text-text-primary">
            スラッグ (URL)
          </label>
          <div class="flex items-center gap-2">
            <span class="text-text-secondary text-sm">/blog/</span>
            <input
              type="text"
              id="slug"
              name="slug"
              value={article.slug}
              class="w-full px-3 py-2.5 text-base text-text-primary bg-surface-base border border-border-default rounded-sm min-h-[44px] focus:outline-2 focus:outline-accent-blue focus:border-accent-blue"
            />
          </div>
        </div>

        <!-- Excerpt -->
        <div class="flex flex-col gap-1.5">
          <label for="excerpt" class="text-sm font-medium text-text-primary">抜粋 / 概要</label>
          <textarea
            id="excerpt"
            name="excerpt"
            rows="3"
            placeholder="記事の概要を簡潔に記載してください（SEOや一覧表示に使用されます）"
            class="w-full px-3 py-2.5 text-base text-text-primary bg-surface-base border border-border-default rounded-sm min-h-[80px] focus:outline-2 focus:outline-accent-blue focus:border-accent-blue resize-y"
          >{article.excerpt || ''}</textarea>
        </div>

        <!-- Content (BlogEditor) -->
        <div class="flex flex-col gap-1.5">
          <label class="text-sm font-medium text-text-primary">本文 *</label>
          <BlogEditor client:load content={article.content} onChange="" />
          <input type="hidden" name="content" id="content" value={article.content} />
        </div>

        <!-- Cover Image URL -->
        <Input
          label="カバー画像URL"
          name="cover_image_url"
          id="cover_image_url"
          type="url"
          placeholder="https://example.com/image.jpg"
          value={article.cover_image_url || ''}
        />

        <!-- Status & Published Date -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="flex flex-col gap-1.5">
            <label for="status" class="text-sm font-medium text-text-primary">ステータス *</label>
            <select
              id="status"
              name="status"
              class="w-full px-3 py-2.5 text-base text-text-primary bg-surface-base border border-border-default rounded-sm min-h-[44px] focus:outline-2 focus:outline-accent-blue focus:border-accent-blue"
            >
              <option value="draft" selected={getStatus(article) === 'draft'}>下書き</option>
              <option value="published" selected={getStatus(article) === 'published'}>公開</option>
              <option value="scheduled" selected={getStatus(article) === 'scheduled'}>公開予約</option>
            </select>
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="published_at" class="text-sm font-medium text-text-primary">公開日時</label>
            <input
              type="datetime-local"
              id="published_at"
              name="published_at"
              value={formatDateForInput(article.published_at)}
              class="w-full px-3 py-2.5 text-base text-text-primary bg-surface-base border border-border-default rounded-sm min-h-[44px] focus:outline-2 focus:outline-accent-blue focus:border-accent-blue"
            />
            <p class="text-xs text-text-secondary">「公開」または「公開予約」の場合に設定</p>
          </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-3 pt-4 border-t border-border-default">
          <Button type="submit" variant="accent" id="submit-btn">
            更新する
          </Button>
          <Button variant="secondary" href="/dashboard/articles">
            戻る
          </Button>
          <span id="form-status" class="text-sm text-text-secondary ml-auto"></span>
        </div>

        {Astro.url.searchParams.get('created') === '1' && (
          <div class="p-3 border border-color-success rounded-sm bg-[color-mix(in_srgb,var(--color-success)_10%,transparent)]">
            <p class="text-sm text-success font-medium">記事が作成されました。内容を確認して編集してください。</p>
          </div>
        )}
      </form>
    ) : (
      <div class="text-center py-16">
        <p class="text-text-secondary">記事を読み込んでいます...</p>
      </div>
    )}
  </div>
</DashboardLayout>

<script>
  // Handle form submission
  const form = document.getElementById('article-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const formStatus = document.getElementById('form-status') as HTMLSpanElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !submitBtn) return;

    const articleId = (form.querySelector('input[name="article_id"]') as HTMLInputElement)?.value;
    if (!articleId) return;

    submitBtn.disabled = true;
    if (formStatus) formStatus.textContent = '送信中...';

    const formData = new FormData(form);
    const status = formData.get('status') as string;
    const publishedAtRaw = formData.get('published_at') as string;

    let published_at: string | null | undefined = undefined;
    if (status === 'published') {
      published_at = publishedAtRaw ? new Date(publishedAtRaw).toISOString() : new Date().toISOString();
    } else if (status === 'scheduled' && publishedAtRaw) {
      published_at = new Date(publishedAtRaw).toISOString();
    } else if (status === 'draft') {
      published_at = null;
    }

    const data: Record<string, unknown> = {
      title: formData.get('title'),
      slug: formData.get('slug') || undefined,
      content: formData.get('content') || '',
      excerpt: formData.get('excerpt') || undefined,
      cover_image_url: formData.get('cover_image_url') || undefined,
    };

    if (published_at !== undefined) {
      data.published_at = published_at;
    }

    try {
      const token = document.cookie
        .split('; ')
        .find(row => row.startsWith('sb-token='))
        ?.split('=')[1];

      const res = await fetch(`/api/articles/${articleId}`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`,
        },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        if (formStatus) formStatus.textContent = '';
        window.location.href = `/dashboard/articles/${articleId}/edit?updated=1`;
      } else {
        const err = await res.json();
        if (formStatus) formStatus.textContent = err.error?.message || 'エラーが発生しました';
        submitBtn.disabled = false;
      }
    } catch {
      if (formStatus) formStatus.textContent = 'ネットワークエラーが発生しました';
      submitBtn.disabled = false;
    }
  });

  // Show success message if updated
  if (new URLSearchParams(window.location.search).get('updated') === '1') {
    const statusEl = document.getElementById('form-status');
    if (statusEl) {
      statusEl.textContent = '更新しました';
      statusEl.style.color = 'var(--color-success)';
      setTimeout(() => { if (statusEl) statusEl.textContent = ''; }, 3000);
    }
  }
</script>
