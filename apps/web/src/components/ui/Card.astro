---
interface Props {
  padding?: "none" | "sm" | "md" | "lg";
  class?: string;
}

const { padding = "md", class: className = "" } = Astro.props;

const paddingClasses = {
  none: "",
  sm: "p-3",
  md: "p-4",
  lg: "p-6",
};
---

<div
  class:list={[
    "bg-surface-elevated border border-border-default rounded-md",
    paddingClasses[padding],
    className,
  ]}
>
  <slot />
</div>
