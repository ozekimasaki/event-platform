# ============================================
# Supabase
# ============================================
# `supabase start` 実行後に出力される値を設定する
# ローカル既定: http://127.0.0.1:54321
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<supabase start 出力の anon key>
SUPABASE_SERVICE_ROLE_KEY=<supabase start 出力の service_role key>
SUPABASE_JWT_SECRET=<supabase start 出力の JWT secret>

# ============================================
# Stripe
# ============================================
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# フロントエンド用 (公開可能キー)
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ============================================
# Web App (Astro)
# ============================================
# API Worker のローカル URL (wrangler dev 既定ポート)
PUBLIC_API_URL=http://localhost:8787

# ============================================
# Cloudflare (デプロイ時のみ必要)
# ============================================
# wrangler login または wrangler whoami で確認
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
