---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
import Card from '../../components/ui/Card.astro';
import { FollowButton } from '../../components/FollowButton';
import type { OrganizerProfile, Event, EventSeries } from '@event-platform/shared';

const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';
const { slug } = Astro.params;

let profile: OrganizerProfile | null = null;
let events: Event[] = [];
let series: EventSeries[] = [];
let isFollowing = false;
let notFound = false;

try {
  const res = await fetch(`${API_BASE}/api/organizers/${slug}`);
  if (res.ok) {
    const json = await res.json();
    profile = json.data;
    isFollowing = json.data.is_following ?? false;
  } else {
    notFound = true;
  }
} catch (err) {
  console.error('Failed to fetch organizer profile:', err);
  notFound = true;
}

// Fetch organizer's events
if (profile) {
  try {
    const eventsRes = await fetch(`${API_BASE}/api/events?organizer_id=${profile.id}&limit=10`);
    if (eventsRes.ok) {
      const eventsJson = await eventsRes.json();
      events = eventsJson.data ?? [];
    }
  } catch (err) {
    console.error('Failed to fetch organizer events:', err);
  }

  // Fetch organizer's event series
  try {
    const seriesRes = await fetch(`${API_BASE}/api/organizers/${profile.id}/series`);
    if (seriesRes.ok) {
      const seriesJson = await seriesRes.json();
      series = seriesJson.data ?? [];
    }
  } catch (err) {
    console.error('Failed to fetch organizer series:', err);
  }
}

const formatDate = (dateStr: string): string => {
  const date = new Date(dateStr);
  return date.toLocaleDateString('ja-JP', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
};

const statusVariant: Record<string, 'default' | 'success' | 'warning' | 'danger' | 'info'> = {
  draft: 'default',
  published: 'success',
  cancelled: 'danger',
  completed: 'warning',
};

const statusLabel: Record<string, string> = {
  draft: '下書き',
  published: '公開中',
  cancelled: 'キャンセル',
  completed: '終了',
};
---

{profile ? (
  <Layout title={`${profile.display_name} | 主催者`}>
    <main class="mx-auto max-w-4xl px-4 py-8 lg:px-6">
      <!-- Profile Header -->
      <div class="mb-8">
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6">
          <!-- Avatar -->
          <div class="w-24 h-24 rounded-full bg-accent-blue/10 flex items-center justify-center text-accent-blue shrink-0 overflow-hidden">
            {profile.avatar_url ? (
              <img src={profile.avatar_url} alt={profile.display_name} class="w-full h-full object-cover" />
            ) : (
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                <circle cx="12" cy="7" r="4" />
              </svg>
            )}
          </div>

          <!-- Profile Info -->
          <div class="flex-1">
            <h1 class="display-md text-text-primary mb-2">{profile.display_name}</h1>
            {profile.bio && (
              <p class="body-lg text-text-secondary mb-4 leading-relaxed">{profile.bio}</p>
            )}
            <div class="flex items-center gap-4 text-sm text-text-secondary">
              <span>
                <span class="font-semibold text-text-primary">{profile.events_count}</span> イベント
              </span>
              <span>
                <span class="font-semibold text-text-primary">{profile.followers_count}</span> フォロワー
              </span>
            </div>
          </div>

          <!-- Follow Button (React Island) -->
          <div class="shrink-0">
            <FollowButton
              client:load
              organizerId={profile.id}
              initialFollowing={isFollowing}
              initialFollowersCount={profile.followers_count}
              apiBase={API_BASE}
            />
          </div>
        </div>
      </div>

      <!-- Event Series -->
      {series.length > 0 && (
        <section class="border-t border-border-default pt-8 mb-8">
          <h2 class="heading-lg text-text-primary mb-4">イベントシリーズ</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {series.map((s) => (
              <Card padding="md">
                <h3 class="heading-sm text-text-primary mb-2">{s.name}</h3>
                {s.description && (
                  <p class="body-sm text-text-secondary">{s.description}</p>
                )}
              </Card>
            ))}
          </div>
        </section>
      )}

      <!-- Upcoming Events -->
      <section class="border-t border-border-default pt-8 mb-8">
        <h2 class="heading-lg text-text-primary mb-4">開催イベント</h2>
        {events.length > 0 ? (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {events.map((event) => (
              <a href={`/events/${event.slug}`} class="no-underline">
                <Card padding="md" class="h-full hover:border-accent-blue/50 transition-colors">
                  {event.cover_image_url && (
                    <div class="aspect-video rounded-md overflow-hidden mb-3 bg-surface-medium">
                      <img src={event.cover_image_url} alt={event.title} class="w-full h-full object-cover" />
                    </div>
                  )}
                  <div class="flex items-center gap-2 mb-2">
                    <Badge variant={statusVariant[event.status] ?? 'default'}>
                      {statusLabel[event.status] ?? event.status}
                    </Badge>
                  </div>
                  <h3 class="heading-sm text-text-primary mb-2">{event.title}</h3>
                  <div class="flex items-center gap-2 text-sm text-text-secondary">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                      <line x1="16" y1="2" x2="16" y2="6" />
                      <line x1="8" y1="2" x2="8" y2="6" />
                      <line x1="3" y1="10" x2="21" y2="10" />
                    </svg>
                    <span>{formatDate(event.start_at)}</span>
                  </div>
                  {event.venue_name && (
                    <div class="flex items-center gap-2 text-sm text-text-secondary mt-1">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                        <circle cx="12" cy="10" r="3" />
                      </svg>
                      <span>{event.venue_name}</span>
                    </div>
                  )}
                </Card>
              </a>
            ))}
          </div>
        ) : (
          <p class="body-lg text-text-secondary">現在開催予定のイベントはありません。</p>
        )}
      </section>

      <!-- Back link -->
      <div class="border-t border-border-default pt-6">
        <a href="/events" class="inline-flex items-center gap-2 text-text-secondary hover:text-text-primary transition-colors no-underline body-sm">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="15 18 9 12 15 6" />
          </svg>
          イベント一覧に戻る
        </a>
      </div>
    </main>
  </Layout>
) : (
  <Layout title="主催者が見つかりません">
    <main class="mx-auto max-w-4xl px-4 py-20 lg:px-6 text-center">
      <h1 class="display-md text-text-primary mb-4">主催者が見つかりませんでした</h1>
      <p class="body-lg text-text-secondary mb-8">
        お探しの主催者は存在しないか、URLが間違っている可能性があります。
      </p>
      <Button variant="accent" href="/events">イベント一覧を見る</Button>
    </main>
  </Layout>
)}
