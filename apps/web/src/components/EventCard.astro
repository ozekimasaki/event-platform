---
import type { Event } from '@event-platform/shared';
import Badge from './ui/Badge.astro';

interface Props {
  event: Event;
}

const { event } = Astro.props;

const statusVariant: Record<string, 'default' | 'success' | 'warning' | 'danger' | 'info'> = {
  draft: 'default',
  published: 'success',
  cancelled: 'danger',
  completed: 'warning',
};

const statusLabel: Record<string, string> = {
  draft: '下書き',
  published: '公開中',
  cancelled: 'キャンセル',
  completed: '終了',
};

const formatDate = (dateStr: string): string => {
  const date = new Date(dateStr);
  return date.toLocaleDateString('ja-JP', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    weekday: 'short',
    hour: '2-digit',
    minute: '2-digit',
  });
};
---

<a
  href={`/events/${event.slug}`}
  class="block group no-underline"
>
  <div class="bg-surface-elevated border border-border-default rounded-md overflow-hidden transition-shadow duration-200 group-hover:shadow-md">
    <!-- Cover Image -->
    <div class="aspect-video bg-surface-medium overflow-hidden">
      {event.cover_image_url ? (
        <img
          src={event.cover_image_url}
          alt={event.title}
          class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
          loading="lazy"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center text-text-secondary">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="opacity-40">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
            <line x1="16" y1="2" x2="16" y2="6" />
            <line x1="8" y1="2" x2="8" y2="6" />
            <line x1="3" y1="10" x2="21" y2="10" />
          </svg>
        </div>
      )}
    </div>

    <!-- Content -->
    <div class="p-4 flex flex-col gap-2">
      <!-- Status Badge -->
      <div class="flex items-center justify-between">
        <Badge variant={statusVariant[event.status] ?? 'default'}>
          {statusLabel[event.status] ?? event.status}
        </Badge>
        {event.pricing_type === 'free' && (
          <Badge variant="info">無料</Badge>
        )}
      </div>

      <!-- Title -->
      <h3 class="heading-sm text-text-primary line-clamp-2 group-hover:text-accent-blue transition-colors">
        {event.title}
      </h3>

      <!-- Date -->
      <div class="flex items-center gap-1.5 text-text-secondary body-sm">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0">
          <circle cx="12" cy="12" r="10" />
          <polyline points="12 6 12 12 16 14" />
        </svg>
        <time datetime={event.start_at}>{formatDate(event.start_at)}</time>
      </div>

      <!-- Venue -->
      {event.venue_name && (
        <div class="flex items-center gap-1.5 text-text-secondary body-sm">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          <span class="truncate">{event.venue_name}</span>
        </div>
      )}
    </div>
  </div>
</a>
