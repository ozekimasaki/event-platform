---
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/ui/Button.astro';
import Badge from '../../../components/ui/Badge.astro';
import Card from '../../../components/ui/Card.astro';
import type { Event, Ticket } from '@event-platform/shared';

const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';
const { slug } = Astro.params;

let event: Event | null = null;
let tickets: (Ticket & { available: number })[] = [];
let notFound = false;

try {
  const res = await fetch(`${API_BASE}/api/events/${slug}`);
  if (res.ok) {
    const json = await res.json();
    event = json.data;
  } else {
    notFound = true;
  }
} catch (err) {
  console.error('Failed to fetch event:', err);
  notFound = true;
}

// Fetch tickets for event
if (event) {
  try {
    const ticketRes = await fetch(`${API_BASE}/api/events/${slug}/tickets`);
    if (ticketRes.ok) {
      const ticketJson = await ticketRes.json();
      tickets = ticketJson.data ?? [];
    }
  } catch (err) {
    console.error('Failed to fetch tickets:', err);
  }
}

const formatDate = (dateStr: string): string => {
  const date = new Date(dateStr);
  return date.toLocaleDateString('ja-JP', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    weekday: 'long',
  });
};

const formatTime = (dateStr: string): string => {
  const date = new Date(dateStr);
  return date.toLocaleTimeString('ja-JP', {
    hour: '2-digit',
    minute: '2-digit',
  });
};

const statusVariant: Record<string, 'default' | 'success' | 'warning' | 'danger' | 'info'> = {
  draft: 'default',
  published: 'success',
  cancelled: 'danger',
  completed: 'warning',
};

const statusLabel: Record<string, string> = {
  draft: '下書き',
  published: '公開中',
  cancelled: 'キャンセル',
  completed: '終了',
};

const pricingLabel: Record<string, string> = {
  free: '無料',
  paid: '有料',
  donation: '投げ銭制',
};

const formatPrice = (price: number, currency: string): string => {
  if (price === 0) return '無料';
  return new Intl.NumberFormat('ja-JP', {
    style: 'currency',
    currency: currency.toUpperCase(),
  }).format(price / 100);
};

// JSON-LD structured data
const jsonLd = event ? {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.title,
  description: event.description?.replace(/<[^>]*>/g, '').substring(0, 200),
  startDate: event.start_at,
  endDate: event.end_at,
  eventStatus: event.status === 'published' ? 'https://schema.org/EventScheduled' : 'https://schema.org/EventCancelled',
  image: event.cover_image_url,
  location: event.venue_name ? {
    '@type': 'Place',
    name: event.venue_name,
    address: event.venue_address,
  } : undefined,
  organizer: {
    '@type': 'Organization',
    name: 'Event Platform',
  },
} : null;
---

{event ? (
  <Layout
    title={`${event.title} | Event Platform`}
    description={event.description?.replace(/<[^>]*>/g, '').substring(0, 160) || ''}
  >
    <!-- JSON-LD -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <main class="mx-auto max-w-4xl px-4 py-8 lg:px-6">
      <!-- Hero Section -->
      <div class="mb-8">
        {event.cover_image_url && (
          <div class="aspect-video rounded-md overflow-hidden mb-6 bg-surface-medium">
            <img
              src={event.cover_image_url}
              alt={event.title}
              class="w-full h-full object-cover"
            />
          </div>
        )}

        <div class="flex items-center gap-3 mb-4">
          <Badge variant={statusVariant[event.status] ?? 'default'}>
            {statusLabel[event.status] ?? event.status}
          </Badge>
          <Badge variant="info">{pricingLabel[event.pricing_type] ?? event.pricing_type}</Badge>
        </div>

        <h1 class="display-lg text-text-primary mb-4">{event.title}</h1>

        <div class="flex flex-col gap-2 body-lg text-text-secondary mb-6">
          <div class="flex items-center gap-2">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-accent-blue shrink-0">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
              <line x1="16" y1="2" x2="16" y2="6" />
              <line x1="8" y1="2" x2="8" y2="6" />
              <line x1="3" y1="10" x2="21" y2="10" />
            </svg>
            <span>
              {formatDate(event.start_at)} {formatTime(event.start_at)} — {formatDate(event.end_at)} {formatTime(event.end_at)}
            </span>
          </div>

          {event.venue_name && (
            <div class="flex items-center gap-2">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-accent-rose shrink-0">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
              <span>{event.venue_name}</span>
              {event.venue_address && <span class="text-text-secondary body-sm">({event.venue_address})</span>}
            </div>
          )}

          {event.capacity && (
            <div class="flex items-center gap-2">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-accent-gold shrink-0">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
              </svg>
              <span>定員: {event.capacity}名</span>
            </div>
          )}
        </div>

        <!-- Registration CTA -->
        {event.status === 'published' && (
          <div class="mb-8">
            <div class="flex items-center gap-4">
              <Button variant="accent" size="lg" href={`/events/${event.slug}/register`}>
                参加登録する
              </Button>
              {event.capacity && (
                <span class="body-sm text-text-secondary">
                  残席: {event.capacity}名
                </span>
              )}
            </div>
          </div>
        )}
      </div>

      <!-- Ticket Info -->
      {tickets.length > 0 && (
        <section class="border-t border-border-default pt-8 mb-8">
          <h2 class="heading-lg text-text-primary mb-4">チケット情報</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {tickets.map((ticket) => (
              <Card padding="md">
                <div class="flex items-start justify-between">
                  <div>
                    <h3 class="heading-sm text-text-primary">{ticket.name}</h3>
                    {ticket.description && (
                      <p class="body-sm text-text-secondary mt-1">{ticket.description}</p>
                    )}
                  </div>
                  <p class="text-lg font-bold text-text-primary shrink-0 ml-4">
                    {formatPrice(ticket.price, event.currency)}
                  </p>
                </div>
                <div class="mt-3 flex items-center gap-2">
                  {ticket.available > 0 ? (
                    <Badge variant="success">残席 {ticket.available}</Badge>
                  ) : (
                    <Badge variant="danger">売り切れ</Badge>
                  )}
                </div>
              </Card>
            ))}
          </div>
        </section>
      )}

      <!-- Description -->
      <section class="border-t border-border-default pt-8 mb-8">
        <h2 class="heading-lg text-text-primary mb-4">イベント詳細</h2>
        <div
          class="prose prose-neutral max-w-none text-text-primary body-lg leading-relaxed"
          set:html={event.description || '<p>詳細情報なし</p>'}
        />
      </section>

      <!-- Tags -->
      {event.tags && event.tags.length > 0 && (
        <section class="border-t border-border-default pt-8 mb-8">
          <h2 class="heading-sm text-text-primary mb-3">タグ</h2>
          <div class="flex flex-wrap gap-2">
            {event.tags.map((tag) => (
              <a
                href={`/events?tag=${encodeURIComponent(tag)}`}
                class="inline-flex items-center px-3 py-1 text-sm bg-surface-medium text-text-secondary rounded-sm hover:bg-surface-elevated hover:text-text-primary transition-colors no-underline border border-border-default"
              >
                #{tag}
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Organizer Info -->
      <section class="border-t border-border-default pt-8 mb-8">
        <h2 class="heading-sm text-text-primary mb-3">主催者</h2>
        <div class="flex items-center gap-3 p-4 bg-surface-soft rounded-md border border-border-default">
          <div class="w-12 h-12 rounded-full bg-accent-blue/10 flex items-center justify-center text-accent-blue">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
              <circle cx="12" cy="7" r="4" />
            </svg>
          </div>
          <div>
            <p class="heading-sm text-text-primary">イベント主催者</p>
            <p class="body-sm text-text-secondary">Event Platform</p>
          </div>
        </div>
      </section>

      <!-- Back link -->
      <div class="border-t border-border-default pt-6">
        <a href="/events" class="inline-flex items-center gap-2 text-text-secondary hover:text-text-primary transition-colors no-underline body-sm">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="15 18 9 12 15 6" />
          </svg>
          イベント一覧に戻る
        </a>
      </div>
    </main>
  </Layout>
) : (
  <Layout title="イベントが見つかりません">
    <main class="mx-auto max-w-4xl px-4 py-20 lg:px-6 text-center">
      <h1 class="display-md text-text-primary mb-4">イベントが見つかりませんでした</h1>
      <p class="body-lg text-text-secondary mb-8">
        お探しのイベントは削除されたか、URLが間違っている可能性があります。
      </p>
      <Button variant="accent" href="/events">イベント一覧を見る</Button>
    </main>
  </Layout>
)}
