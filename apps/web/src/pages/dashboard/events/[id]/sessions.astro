---
import DashboardLayout from '../../layout.astro';
import Card from '../../../../components/ui/Card.astro';
import Badge from '../../../../components/ui/Badge.astro';
import Button from '../../../../components/ui/Button.astro';
import type { Session } from '@event-platform/shared';

const { id } = Astro.params;
const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';
const token = Astro.cookies.get('sb-token')?.value || '';

const headers = { 'Authorization': `Bearer ${token}` };

// Fetch event
let event: any = null;
let sessionsList: Session[] = [];

try {
  const eventRes = await fetch(`${API_BASE}/api/events/by-id/${id}`, { headers });
  if (eventRes.ok) {
    const eventJson = await eventRes.json();
    event = eventJson.data;
  }
} catch (err) {
  console.error('Failed to fetch event:', err);
}

// Fetch sessions
if (event) {
  try {
    const sessRes = await fetch(`${API_BASE}/api/events/${event.id}/sessions`, { headers });
    if (sessRes.ok) {
      const sessJson = await sessRes.json();
      sessionsList = sessJson.data || [];
    }
  } catch (err) {
    console.error('Failed to fetch sessions:', err);
  }
}

const formatDateTime = (dateStr: string): string => {
  return new Date(dateStr).toLocaleString('ja-JP', {
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
};
---

<DashboardLayout
  title="セッション管理"
  breadcrumbs={[
    { label: 'イベント管理', href: '/dashboard/events' },
    { label: event?.title ?? 'イベント', href: `/dashboard/events/${id}/edit` },
    { label: 'セッション管理' },
  ]}
>
  <div class="flex items-center justify-between mb-6 flex-wrap gap-4">
    <div>
      <h1 class="heading-lg text-text-primary">セッション管理</h1>
      {event && <p class="text-sm text-text-secondary mt-1">{event.title}</p>}
    </div>
    <Button variant="accent" onclick="openCreateModal()">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="12" y1="5" x2="12" y2="19" />
        <line x1="5" y1="12" x2="19" y2="12" />
      </svg>
      セッション追加
    </Button>
  </div>

  <!-- Sessions List -->
  {sessionsList.length > 0 ? (
    <div class="border border-border-default rounded-md overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-surface-soft border-b border-border-default">
              <th class="text-left px-4 py-3 font-medium text-text-secondary">タイトル</th>
              <th class="text-left px-4 py-3 font-medium text-text-secondary hidden sm:table-cell">トラック</th>
              <th class="text-left px-4 py-3 font-medium text-text-secondary">日時</th>
              <th class="text-right px-4 py-3 font-medium text-text-secondary">操作</th>
            </tr>
          </thead>
          <tbody>
            {sessionsList.map((session) => (
              <tr class="border-b border-border-default last:border-b-0 hover:bg-surface-soft transition-colors">
                <td class="px-4 py-3">
                  <p class="font-medium text-text-primary">{session.title}</p>
                  {session.description && (
                    <p class="text-xs text-text-secondary mt-0.5 truncate max-w-xs">{session.description}</p>
                  )}
                </td>
                <td class="px-4 py-3 hidden sm:table-cell">
                  <Badge variant="info">{session.track || 'Main'}</Badge>
                </td>
                <td class="px-4 py-3 text-text-secondary text-xs">
                  {formatDateTime(session.start_at)} - {formatDateTime(session.end_at)}
                </td>
                <td class="px-4 py-3">
                  <div class="flex items-center justify-end gap-1">
                    <button
                      type="button"
                      class="inline-flex items-center justify-center w-8 h-8 min-w-[36px] min-h-[36px] rounded-sm text-text-secondary hover:text-accent-blue hover:bg-surface-medium transition-colors"
                      title="編集"
                      data-session-id={session.id}
                      data-session-title={session.title}
                      data-session-description={session.description || ''}
                      data-session-track={session.track || ''}
                      data-session-start={session.start_at}
                      data-session-end={session.end_at}
                      onclick="openEditModal(this)"
                    >
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                      </svg>
                    </button>
                    <button
                      type="button"
                      class="inline-flex items-center justify-center w-8 h-8 min-w-[36px] min-h-[36px] rounded-sm text-text-secondary hover:text-danger hover:bg-surface-medium transition-colors"
                      title="削除"
                      data-session-id={session.id}
                      data-session-title={session.title}
                      onclick="handleDeleteSession(this)"
                    >
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="3 6 5 6 21 6" />
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                      </svg>
                    </button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  ) : (
    <Card padding="lg">
      <div class="text-center py-12">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mx-auto text-text-secondary opacity-40 mb-4">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
          <line x1="16" y1="2" x2="16" y2="6" />
          <line x1="8" y1="2" x2="8" y2="6" />
          <line x1="3" y1="10" x2="21" y2="10" />
        </svg>
        <p class="heading-sm text-text-secondary mb-2">セッションがまだありません</p>
        <p class="body-sm text-text-secondary mb-4">タイムテーブルにセッションを追加しましょう</p>
        <Button variant="accent" onclick="openCreateModal()">セッションを追加</Button>
      </div>
    </Card>
  )}

  <!-- Create/Edit Modal -->
  <div id="session-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50">
    <div class="bg-surface-elevated border border-border-default rounded-md p-6 w-full max-w-lg mx-4 max-h-[90vh] overflow-y-auto">
      <h2 id="modal-title" class="text-lg font-semibold text-text-primary mb-4">セッション追加</h2>
      <form id="session-form" class="space-y-4">
        <input type="hidden" id="session-id" />
        <div>
          <label for="sess-title" class="block text-sm font-medium text-text-primary mb-1">タイトル *</label>
          <input type="text" id="sess-title" required maxlength="300" class="w-full px-3 py-2 text-sm text-text-primary bg-surface-base border border-border-default rounded-sm min-h-[44px] focus:outline-2 focus:outline-accent-blue" />
        </div>
        <div>
          <label for="sess-desc" class="block text-sm font-medium text-text-primary mb-1">説明</label>
          <textarea id="sess-desc" rows="3" maxlength="5000" class="w-full px-3 py-2 text-sm text-text-primary bg-surface-base border border-border-default rounded-sm focus:outline-2 focus:outline-accent-blue resize-y" />
        </div>
        <div>
          <label for="sess-track" class="block text-sm font-medium text-text-primary mb-1">トラック</label>
          <input type="text" id="sess-track" maxlength="100" placeholder="Main" class="w-full px-3 py-2 text-sm text-text-primary bg-surface-base border border-border-default rounded-sm min-h-[44px] focus:outline-2 focus:outline-accent-blue" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="sess-start" class="block text-sm font-medium text-text-primary mb-1">開始日時 *</label>
            <input type="datetime-local" id="sess-start" required class="w-full px-3 py-2 text-sm text-text-primary bg-surface-base border border-border-default rounded-sm min-h-[44px] focus:outline-2 focus:outline-accent-blue" />
          </div>
          <div>
            <label for="sess-end" class="block text-sm font-medium text-text-primary mb-1">終了日時 *</label>
            <input type="datetime-local" id="sess-end" required class="w-full px-3 py-2 text-sm text-text-primary bg-surface-base border border-border-default rounded-sm min-h-[44px] focus:outline-2 focus:outline-accent-blue" />
          </div>
        </div>
        <div class="flex gap-2 pt-2">
          <Button type="submit" variant="accent" id="modal-submit-btn">保存</Button>
          <Button variant="secondary" onclick="closeModal()">キャンセル</Button>
        </div>
        <div id="modal-status" class="hidden"></div>
      </form>
    </div>
  </div>
</DashboardLayout>

<script>
  const eventId = window.location.pathname.split('/')[3];
  const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';

  function getToken(): string {
    return document.cookie.split('; ').find(row => row.startsWith('sb-token='))?.split('=')[1] || '';
  }

  function openCreateModal() {
    const modal = document.getElementById('session-modal')!;
    document.getElementById('modal-title')!.textContent = 'セッション追加';
    (document.getElementById('session-id') as HTMLInputElement).value = '';
    (document.getElementById('sess-title') as HTMLInputElement).value = '';
    (document.getElementById('sess-desc') as HTMLTextAreaElement).value = '';
    (document.getElementById('sess-track') as HTMLInputElement).value = '';
    (document.getElementById('sess-start') as HTMLInputElement).value = '';
    (document.getElementById('sess-end') as HTMLInputElement).value = '';
    document.getElementById('modal-status')!.className = 'hidden';
    modal.classList.remove('hidden');
  }

  function openEditModal(btn: HTMLButtonElement) {
    const modal = document.getElementById('session-modal')!;
    document.getElementById('modal-title')!.textContent = 'セッション編集';
    (document.getElementById('session-id') as HTMLInputElement).value = btn.dataset.sessionId || '';
    (document.getElementById('sess-title') as HTMLInputElement).value = btn.dataset.sessionTitle || '';
    (document.getElementById('sess-desc') as HTMLTextAreaElement).value = btn.dataset.sessionDescription || '';
    (document.getElementById('sess-track') as HTMLInputElement).value = btn.dataset.sessionTrack || '';
    const startStr = btn.dataset.sessionStart || '';
    const endStr = btn.dataset.sessionEnd || '';
    (document.getElementById('sess-start') as HTMLInputElement).value = startStr ? startStr.slice(0, 16) : '';
    (document.getElementById('sess-end') as HTMLInputElement).value = endStr ? endStr.slice(0, 16) : '';
    document.getElementById('modal-status')!.className = 'hidden';
    modal.classList.remove('hidden');
  }

  function closeModal() {
    document.getElementById('session-modal')!.classList.add('hidden');
  }

  async function handleDeleteSession(btn: HTMLButtonElement) {
    const sessionId = btn.dataset.sessionId;
    const sessionTitle = btn.dataset.sessionTitle;
    if (!confirm(`「${sessionTitle}」を削除しますか？`)) return;

    try {
      const res = await fetch(`${API_BASE}/api/sessions/${sessionId}`, {
        method: 'DELETE',
        headers: { 'Authorization': `Bearer ${getToken()}` },
      });
      if (res.ok) location.reload();
      else alert('削除に失敗しました');
    } catch {
      alert('エラーが発生しました');
    }
  }

  document.getElementById('session-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const sessionId = (document.getElementById('session-id') as HTMLInputElement).value;
    const statusEl = document.getElementById('modal-status')!;

    const payload: any = {
      title: (document.getElementById('sess-title') as HTMLInputElement).value,
      description: (document.getElementById('sess-desc') as HTMLTextAreaElement).value || null,
      track: (document.getElementById('sess-track') as HTMLInputElement).value || null,
      start_at: new Date((document.getElementById('sess-start') as HTMLInputElement).value).toISOString(),
      end_at: new Date((document.getElementById('sess-end') as HTMLInputElement).value).toISOString(),
    };

    try {
      let res: Response;
      if (sessionId) {
        res = await fetch(`${API_BASE}/api/sessions/${sessionId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${getToken()}` },
          body: JSON.stringify(payload),
        });
      } else {
        payload.event_id = eventId;
        res = await fetch(`${API_BASE}/api/events/${eventId}/sessions`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${getToken()}` },
          body: JSON.stringify(payload),
        });
      }

      if (res.ok) {
        location.reload();
      } else {
        const json = await res.json();
        statusEl.className = 'p-2 rounded-sm text-sm bg-[color-mix(in_srgb,var(--color-danger)_15%,transparent)] text-danger';
        statusEl.textContent = json.error?.message || '保存に失敗しました';
      }
    } catch {
      statusEl.className = 'p-2 rounded-sm text-sm bg-[color-mix(in_srgb,var(--color-danger)_15%,transparent)] text-danger';
      statusEl.textContent = 'エラーが発生しました';
    }
  });
</script>
