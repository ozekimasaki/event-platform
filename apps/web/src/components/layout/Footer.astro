---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-border-default bg-surface-soft">
  <div class="mx-auto max-w-7xl px-4 py-12 lg:px-6">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Brand -->
      <div class="sm:col-span-2 lg:col-span-1">
        <a href="/" class="flex items-center gap-2 text-text-primary no-underline mb-4">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent-blue">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
            <line x1="16" y1="2" x2="16" y2="6" />
            <line x1="8" y1="2" x2="8" y2="6" />
            <line x1="3" y1="10" x2="21" y2="10" />
          </svg>
          <span class="text-base font-semibold">Event Platform</span>
        </a>
        <p class="text-sm text-text-secondary max-w-xs">
          イベントの作成・管理・運営をワンストップで。オンライン・オフライン問わず、最高の体験を届けます。
        </p>
      </div>

      <!-- Product -->
      <div>
        <h3 class="text-sm font-semibold text-text-primary mb-3">プロダクト</h3>
        <ul class="flex flex-col gap-2 list-none p-0 m-0">
          <li><a href="/features" class="text-sm text-text-secondary hover:text-text-primary transition-colors no-underline">機能一覧</a></li>
          <li><a href="/pricing" class="text-sm text-text-secondary hover:text-text-primary transition-colors no-underline">料金プラン</a></li>
          <li><a href="/integrations" class="text-sm text-text-secondary hover:text-text-primary transition-colors no-underline">連携</a></li>
          <li><a href="/changelog" class="text-sm text-text-secondary hover:text-text-primary transition-colors no-underline">更新履歴</a></li>
        </ul>
      </div>

      <!-- Support -->
      <div>
        <h3 class="text-sm font-semibold text-text-primary mb-3">サポート</h3>
        <ul class="flex flex-col gap-2 list-none p-0 m-0">
          <li><a href="/docs" class="text-sm text-text-secondary hover:text-text-primary transition-colors no-underline">ドキュメント</a></li>
          <li><a href="/help" class="text-sm text-text-secondary hover:text-text-primary transition-colors no-underline">ヘルプセンター</a></li>
          <li><a href="/contact" class="text-sm text-text-secondary hover:text-text-primary transition-colors no-underline">お問い合わせ</a></li>
          <li><a href="/status" class="text-sm text-text-secondary hover:text-text-primary transition-colors no-underline">ステータス</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="text-sm font-semibold text-text-primary mb-3">法的情報</h3>
        <ul class="flex flex-col gap-2 list-none p-0 m-0">
          <li><a href="/privacy" class="text-sm text-text-secondary hover:text-text-primary transition-colors no-underline">プライバシーポリシー</a></li>
          <li><a href="/terms" class="text-sm text-text-secondary hover:text-text-primary transition-colors no-underline">利用規約</a></li>
          <li><a href="/tokushoho" class="text-sm text-text-secondary hover:text-text-primary transition-colors no-underline">特定商取引法に基づく表記</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom -->
    <div class="mt-10 pt-6 border-t border-border-default flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-text-secondary m-0">
        &copy; {currentYear} Event Platform. All rights reserved.
      </p>
      <!-- Social icons -->
      <div class="flex items-center gap-4">
        <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)" class="text-text-secondary hover:text-text-primary transition-colors">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
        </a>
        <a href="https://github.com" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="text-text-secondary hover:text-text-primary transition-colors">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
