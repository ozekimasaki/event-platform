---
interface Props {
  label?: string;
  error?: string;
  type?: string;
  placeholder?: string;
  name?: string;
  id?: string;
  disabled?: boolean;
  class?: string;
}

const {
  label,
  error,
  type = "text",
  placeholder = "",
  name,
  id,
  disabled = false,
  class: className = "",
} = Astro.props;

const inputId = id || name || "input";
---

<div class="flex flex-col gap-1.5">
  {label && (
    <label for={inputId} class="text-sm font-medium text-text-primary">
      {label}
    </label>
  )}
  <input
    id={inputId}
    type={type}
    name={name}
    placeholder={placeholder}
    disabled={disabled}
    aria-invalid={error ? "true" : undefined}
    aria-describedby={error ? `${inputId}-error` : undefined}
    class:list={[
      "w-full px-3 py-2.5 text-base text-text-primary bg-surface-base border rounded-sm placeholder:text-text-secondary transition-colors duration-200 min-h-[44px] focus:outline-2 focus:outline-accent-blue focus:outline-offset-0 focus:border-accent-blue",
      disabled && "opacity-50 cursor-not-allowed bg-surface-soft",
      error ? "border-danger focus:outline-danger focus:border-danger" : "border-border-default",
      className,
    ]}
  />
  {error && (
    <p id={`${inputId}-error`} class="text-sm text-danger" role="alert">
      {error}
    </p>
  )}
</div>
