---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/layout/Sidebar.astro';

interface Props {
  title?: string;
  breadcrumbs?: { label: string; href?: string }[];
}

const { title = 'ダッシュボード', breadcrumbs = [] } = Astro.props;

const sidebarItems = [
  {
    label: 'イベント管理',
    href: '/dashboard/events',
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>',
    active: Astro.url.pathname.startsWith('/dashboard/events') && !Astro.url.pathname.includes('/new') && Astro.url.searchParams.get('tab') !== 'revenue' && !Astro.url.pathname.match(/\/dashboard\/events\/[^/]+\//),
  },
  {
    label: '新規イベント作成',
    href: '/dashboard/events/new',
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>',
    active: Astro.url.pathname === '/dashboard/events/new',
  },
  {
    label: '売上管理',
    href: '/dashboard/events?tab=revenue',
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>',
    active: Astro.url.searchParams.get('tab') === 'revenue',
  },
  {
    label: 'メール配信',
    href: '/dashboard/email',
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>',
    active: Astro.url.pathname.startsWith('/dashboard/email'),
  },
  {
    label: '通知管理',
    href: '/dashboard/notifications',
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>',
    active: Astro.url.pathname.startsWith('/dashboard/notifications'),
  },
  {
    label: '設定',
    href: '/dashboard/settings',
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>',
    active: Astro.url.pathname.startsWith('/dashboard/settings'),
  },
];
---

<Layout title={`${title} | ダッシュボード`}>
  <div class="flex min-h-[calc(100vh-64px)]">
    <Sidebar items={sidebarItems} />

    <div class="flex-1 flex flex-col min-w-0">
      <!-- Breadcrumb -->
      {breadcrumbs.length > 0 && (
        <nav class="flex items-center gap-2 px-6 py-3 border-b border-border-default bg-surface-base text-sm" aria-label="パンくずリスト">
          <a href="/dashboard" class="text-text-secondary hover:text-text-primary transition-colors no-underline">
            ダッシュボード
          </a>
          {breadcrumbs.map((crumb, i) => (
            <>
              <span class="text-text-secondary">/</span>
              {crumb.href ? (
                <a
                  href={crumb.href}
                  class:list={[
                    'no-underline transition-colors',
                    i === breadcrumbs.length - 1
                      ? 'text-text-primary font-medium'
                      : 'text-text-secondary hover:text-text-primary',
                  ]}
                >
                  {crumb.label}
                </a>
              ) : (
                <span class="text-text-primary font-medium">{crumb.label}</span>
              )}
            </>
          ))}
        </nav>
      )}

      <!-- Main content -->
      <main class="flex-1 p-6 overflow-auto">
        <slot />
      </main>
    </div>
  </div>
</Layout>
