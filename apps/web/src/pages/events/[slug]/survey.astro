---
import Layout from '../../../../layouts/Layout.astro';
import Button from '../../../../components/ui/Button.astro';
import Card from '../../../../components/ui/Card.astro';
import type { Event, Survey, SurveyQuestion } from '@event-platform/shared';

const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';
const { slug } = Astro.params;

let event: Event | null = null;
let survey: Survey | null = null;
let userResponse: Record<string, string | number | string[]> | null = null;
let alreadyResponded = false;
let notFound = false;
let errorMessage = '';

// Fetch event
try {
  const res = await fetch(`${API_BASE}/api/events/${slug}`);
  if (res.ok) {
    const json = await res.json();
    event = json.data;
  } else {
    notFound = true;
  }
} catch (err) {
  console.error('Failed to fetch event:', err);
  notFound = true;
}

// Fetch surveys for event
if (event) {
  try {
    const surveyRes = await fetch(`${API_BASE}/api/events/${event.id}/surveys`);
    if (surveyRes.ok) {
      const surveyJson = await surveyRes.json();
      const allSurveys: Survey[] = surveyJson.data ?? [];
      // Find first active survey
      survey = allSurveys.find((s) => s.is_active) ?? allSurveys[0] ?? null;
    }
  } catch (err) {
    console.error('Failed to fetch surveys:', err);
  }

  // If user is logged in, check their response
  if (survey) {
    try {
      const token = Astro.cookies.get('sb-access-token')?.value;
      if (token) {
        const detailRes = await fetch(`${API_BASE}/api/surveys/${survey.id}`, {
          headers: { 'Authorization': `Bearer ${token}` },
        });
        if (detailRes.ok) {
          const detailJson = await detailRes.json();
          if (detailJson.data.user_response) {
            alreadyResponded = true;
            userResponse = detailJson.data.user_response.answers;
          }
        }
      }
    } catch {
      // Ignore - will show survey without pre-fill
    }
  }
}

const formatDate = (dateStr: string): string => {
  const date = new Date(dateStr);
  return date.toLocaleDateString('ja-JP', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};
---

{event ? (
  <Layout title={`アンケート - ${event.title} | Event Platform`}>
    <main class="mx-auto max-w-2xl px-4 py-8 lg:px-6">
      <!-- Back link -->
      <a
        href={`/events/${event.slug}`}
        class="inline-flex items-center gap-1.5 text-text-secondary hover:text-text-primary transition-colors no-underline body-sm mb-6"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15 18 9 12 15 6" />
        </svg>
        イベントページに戻る
      </a>

      <h1 class="display-md text-text-primary mb-2">アンケート</h1>
      <p class="body-lg text-text-secondary mb-8">{event.title}</p>

      {!survey ? (
        <Card padding="md">
          <div class="text-center py-8">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mx-auto text-text-secondary mb-4">
              <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" />
              <rect x="9" y="3" width="6" height="4" rx="1" />
            </svg>
            <p class="text-text-primary font-medium mb-1">アンケートはまだありません</p>
            <p class="text-text-secondary body-sm">このイベントにはまだアンケートが設定されていません。</p>
          </div>
        </Card>
      ) : alreadyResponded ? (
        <Card padding="md">
          <div class="text-center py-8">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mx-auto text-green-500 mb-4">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
              <polyline points="22 4 12 14.01 9 11.01" />
            </svg>
            <p class="text-text-primary font-medium mb-1">ご回答ありがとうございます</p>
            <p class="text-text-secondary body-sm">このアンケートには既にご回答済みです。</p>
          </div>
        </Card>
      ) : (
        <>
          {survey.description && (
            <p class="body-sm text-text-secondary mb-6">{survey.description}</p>
          )}

          <form id="survey-form" class="flex flex-col gap-6">
            {survey.questions.map((q, index) => (
              <Card padding="md">
                <div class="flex items-start gap-3 mb-4">
                  <span class="flex items-center justify-center w-7 h-7 rounded-full bg-accent-blue/10 text-accent-blue text-sm font-semibold shrink-0">
                    {index + 1}
                  </span>
                  <div>
                    <p class="text-text-primary font-medium">
                      {q.question}
                      {q.required && <span class="text-danger ml-1">*</span>}
                    </p>
                  </div>
                </div>

                <div class="pl-10">
                  {q.type === 'text' && (
                    <textarea
                      name={q.id}
                      rows={3}
                      class="w-full px-3 py-2 border border-border-default rounded-sm bg-surface-base text-text-primary placeholder-text-secondary/50 focus:outline-none focus:ring-2 focus:ring-accent-blue/50 focus:border-accent-blue resize-none body-sm"
                      placeholder="回答を入力してください..."
                      required={q.required}
                    />
                  )}

                  {q.type === 'choice' && q.options && (
                    <div class="flex flex-col gap-2">
                      {q.options.map((opt) => (
                        <label class="flex items-center gap-3 p-2.5 border border-border-default rounded-sm cursor-pointer hover:bg-surface-medium transition-colors">
                          <input
                            type="radio"
                            name={q.id}
                            value={opt}
                            class="accent-accent-blue"
                            required={q.required}
                          />
                          <span class="text-text-primary body-sm">{opt}</span>
                        </label>
                      ))}
                    </div>
                  )}

                  {q.type === 'rating' && (
                    <div class="flex items-center gap-2" data-rating={q.id}>
                      {[1, 2, 3, 4, 5].map((n) => (
                        <label class="cursor-pointer">
                          <input
                            type="radio"
                            name={q.id}
                            value={n}
                            class="sr-only peer"
                            required={q.required}
                          />
                          <span class="text-3xl text-gray-300 peer-checked:text-yellow-400 transition-colors">★</span>
                        </label>
                      ))}
                    </div>
                  )}

                  {q.type === 'multi' && q.options && (
                    <div class="flex flex-col gap-2">
                      {q.options.map((opt) => (
                        <label class="flex items-center gap-3 p-2.5 border border-border-default rounded-sm cursor-pointer hover:bg-surface-medium transition-colors">
                          <input
                            type="checkbox"
                            name={`${q.id}[]`}
                            value={opt}
                            class="accent-accent-blue"
                          />
                          <span class="text-text-primary body-sm">{opt}</span>
                        </label>
                      ))}
                    </div>
                  )}
                </div>
              </Card>
            ))}

            <!-- Submit -->
            <Button variant="accent" size="lg" class="w-full" id="submit-btn">
              回答を送信する
            </Button>

            <!-- Status messages -->
            <div id="survey-status" class="hidden">
              <div id="status-success" class="hidden p-4 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-sm">
                <p class="text-green-800 dark:text-green-200 font-medium">回答を送信しました！ご協力ありがとうございます。</p>
              </div>
              <div id="status-error" class="hidden p-4 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-sm">
                <p class="text-red-800 dark:text-red-200 font-medium">エラーが発生しました</p>
                <p id="error-message" class="text-red-700 dark:text-red-300 text-sm mt-1"></p>
              </div>
            </div>
          </form>
        </>
      )}
    </main>

    {survey && !alreadyResponded && (
      <script define:vars={{ surveyId: survey.id, apiBase: API_BASE }}>
        (function() {
          const form = document.getElementById('survey-form');
          if (!form) return;

          form.addEventListener('submit', async (e) => {
            e.preventDefault();

            const statusDiv = document.getElementById('survey-status');
            const successDiv = document.getElementById('status-success');
            const errorDiv = document.getElementById('status-error');
            const errorMsg = document.getElementById('error-message');
            const btn = document.getElementById('submit-btn');

            statusDiv.classList.remove('hidden');
            successDiv.classList.add('hidden');
            errorDiv.classList.add('hidden');

            const token = localStorage.getItem('sb-access-token');
            if (!token) {
              errorDiv.classList.remove('hidden');
              errorMsg.textContent = 'ログインが必要です。ログインページに移動します。';
              setTimeout(() => { window.location.href = '/login'; }, 2000);
              return;
            }

            btn.disabled = true;
            btn.textContent = '送信中...';

            try {
              // Collect answers
              const formData = new FormData(form);
              const answers = {};

              // Process form data - handle radio, checkbox, textarea
              const processed = new Set();
              for (const [key, value] of formData.entries()) {
                if (key.endsWith('[]')) {
                  // Multi-select checkbox
                  const qId = key.slice(0, -2);
                  if (!answers[qId]) answers[qId] = [];
                  answers[qId].push(value);
                } else {
                  answers[key] = value;
                }
                processed.add(key);
              }

              // Convert rating values to numbers
              for (const [key, value] of Object.entries(answers)) {
                if (typeof value === 'string' && !isNaN(Number(value))) {
                  answers[key] = Number(value);
                }
              }

              const res = await fetch(`${apiBase}/api/surveys/${surveyId}/respond`, {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                  'Authorization': `Bearer ${token}`,
                },
                body: JSON.stringify({ answers }),
              });

              const json = await res.json();

              if (!res.ok) {
                throw new Error(json.error?.message || '送信に失敗しました');
              }

              successDiv.classList.remove('hidden');
              form.classList.add('hidden');
            } catch (err) {
              errorDiv.classList.remove('hidden');
              errorMsg.textContent = err.message || 'エラーが発生しました';
            } finally {
              btn.disabled = false;
              btn.textContent = '回答を送信する';
            }
          });
        })();
      </script>
    )}
  </Layout>
) : (
  <Layout title="イベントが見つかりません">
    <main class="mx-auto max-w-2xl px-4 py-20 lg:px-6 text-center">
      <h1 class="display-md text-text-primary mb-4">イベントが見つかりませんでした</h1>
      <p class="body-lg text-text-secondary mb-8">
        お探しのイベントは削除されたか、URLが間違っている可能性があります。
      </p>
      <Button variant="accent" href="/events">イベント一覧を見る</Button>
    </main>
  </Layout>
)}
