---
interface NavItem {
  label: string;
  href: string;
  icon?: string;
  active?: boolean;
}

interface Props {
  items?: NavItem[];
  collapsed?: boolean;
}

const { items = [], collapsed = false } = Astro.props;
---

<aside
  class:list={[
    "flex flex-col border-r border-border-default bg-surface-soft h-screen sticky top-0 transition-all duration-200",
    collapsed ? "w-16" : "w-60",
  ]}
  aria-label="サイドナビゲーション"
>
  <!-- Toggle button -->
  <div class="flex items-center justify-end p-3 border-b border-border-default">
    <button
      id="sidebar-toggle"
      class="inline-flex items-center justify-center w-10 h-10 min-w-[44px] min-h-[44px] rounded-sm text-text-secondary hover:text-text-primary hover:bg-surface-medium transition-colors"
      aria-label={collapsed ? "サイドバーを展開" : "サイドバーを折りたたむ"}
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class:list={[collapsed && "rotate-180"]}>
        <polyline points="15 18 9 12 15 6" />
      </svg>
    </button>
  </div>

  <!-- Nav items -->
  <nav class="flex-1 overflow-y-auto py-3">
    <ul class="flex flex-col gap-1 px-2 list-none p-0 m-0">
      {items.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              "flex items-center gap-3 rounded-sm px-3 py-2.5 text-sm font-medium transition-colors no-underline min-h-[44px]",
              item.active
                ? "bg-surface-elevated text-accent-blue border-l-2 border-l-accent-blue"
                : "text-text-secondary hover:text-text-primary hover:bg-surface-medium",
              collapsed && "justify-center px-0",
            ]}
            title={collapsed ? item.label : undefined}
          >
            {item.icon && (
              <span class="shrink-0 w-5 h-5 flex items-center justify-center text-base" innerHTML={item.icon} />
            )}
            {!collapsed && <span>{item.label}</span>}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</aside>
