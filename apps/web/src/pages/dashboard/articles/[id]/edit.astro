---
import DashboardLayout from '../../../layout.astro';
import Button from '../../../components/ui/Button.astro';
import Card from '../../../components/ui/Card.astro';
import Badge from '../../../components/ui/Badge.astro';
import BlogEditor from '../../../../components/BlogEditor';
import type { Article } from '@event-platform/shared';

const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';
const token = Astro.cookies.get('sb-token')?.value || '';

const { id } = Astro.params;

let article: Article | null = null;
let fetchError = false;

try {
  const res = await fetch(`${API_BASE}/api/articles/by-id/${id}`, {
    headers: { 'Authorization': `Bearer ${token}` },
  });
  if (res.ok) {
    const json = await res.json();
    article = json.data;
  } else {
    fetchError = true;
  }
} catch (err) {
  console.error('Failed to fetch article:', err);
  fetchError = true;
}

if (fetchError || !article) {
  return Astro.redirect('/dashboard/articles');
}

const statusVariant: Record<string, 'default' | 'success' | 'warning' | 'info'> = {
  draft: 'default',
  published: 'success',
  scheduled: 'warning',
  archived: 'info',
};

const statusLabel: Record<string, string> = {
  draft: '下書き',
  published: '公開中',
  scheduled: '予約済み',
  archived: 'アーカイブ',
};

const formatDate = (dateStr: string): string => {
  return new Date(dateStr).toLocaleDateString('ja-JP', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
};
---

<DashboardLayout
  title="記事編集"
  breadcrumbs={[{ label: '記事管理', href: '/dashboard/articles' }, { label: article.title }]}
>
  <div class="max-w-4xl">
    <!-- Header -->
    <div class="flex items-center justify-between mb-6 flex-wrap gap-4">
      <div class="flex items-center gap-3">
        <h1 class="heading-lg text-text-primary">記事編集</h1>
        <Badge variant={statusVariant[article.status ?? 'draft'] ?? 'default'}>
          {statusLabel[article.status ?? 'draft'] ?? article.status}
        </Badge>
      </div>
      <div class="flex items-center gap-2 text-sm text-text-secondary">
        <span>最終更新: {formatDate(article.updated_at)}</span>
        {article.status === 'published' && (
          <a href={`/blog/${article.slug}`} target="_blank" class="text-accent-blue hover:underline no-underline">
            記事を表示 ↗
          </a>
        )}
      </div>
    </div>

    <form id="article-form" data-article-id={article.id} class="flex flex-col gap-6">
      <!-- Title -->
      <Card padding="md">
        <div class="flex flex-col gap-4">
          <div>
            <label for="title" class="block text-sm font-medium text-text-primary mb-1.5">
              タイトル <span class="text-danger">*</span>
            </label>
            <input
              type="text"
              id="title"
              name="title"
              required
              maxlength="300"
              value={article.title}
              class="w-full px-3 py-2.5 text-base text-text-primary bg-surface-base border border-border-default rounded-sm min-h-[44px] focus:outline-2 focus:outline-accent-blue focus:border-accent-blue"
            />
          </div>

          <div>
            <label for="slug" class="block text-sm font-medium text-text-primary mb-1.5">
              スラッグ（URL）
            </label>
            <div class="flex items-center gap-2">
              <span class="text-sm text-text-secondary whitespace-nowrap">/blog/</span>
              <input
                type="text"
                id="slug"
                name="slug"
                maxlength="300"
                pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
                value={article.slug}
                class="w-full px-3 py-2.5 text-base text-text-primary bg-surface-base border border-border-default rounded-sm min-h-[44px] focus:outline-2 focus:outline-accent-blue focus:border-accent-blue"
              />
            </div>
          </div>
        </div>
      </Card>

      <!-- Content -->
      <Card padding="md">
        <div class="flex flex-col gap-2">
          <label class="block text-sm font-medium text-text-primary mb-1.5">
            本文 <span class="text-danger">*</span>
          </label>
          <BlogEditor client:load content={article.content} onChange="" />
          <input type="hidden" id="content" name="content" value={article.content} />
        </div>
      </Card>

      <!-- Excerpt & Cover Image -->
      <Card padding="md">
        <div class="flex flex-col gap-4">
          <div>
            <label for="excerpt" class="block text-sm font-medium text-text-primary mb-1.5">
              抜粋（メタディスクリプション）
            </label>
            <textarea
              id="excerpt"
              name="excerpt"
              maxlength="500"
              rows="3"
              class="w-full px-3 py-2.5 text-base text-text-primary bg-surface-base border border-border-default rounded-sm focus:outline-2 focus:outline-accent-blue focus:border-accent-blue resize-y"
            >{article.excerpt}</textarea>
          </div>

          <div>
            <label for="cover_image_url" class="block text-sm font-medium text-text-primary mb-1.5">
              カバー画像URL
            </label>
            <input
              type="url"
              id="cover_image_url"
              name="cover_image_url"
              value={article.cover_image_url || ''}
              placeholder="https://example.com/image.jpg"
              class="w-full px-3 py-2.5 text-base text-text-primary bg-surface-base border border-border-default rounded-sm min-h-[44px] focus:outline-2 focus:outline-accent-blue focus:border-accent-blue"
            />
            {article.cover_image_url && (
              <div class="mt-2">
                <img src={article.cover_image_url} alt="Cover preview" class="h-24 object-cover rounded-sm" />
              </div>
            )}
          </div>
        </div>
      </Card>

      <!-- SEO Metadata -->
      <Card padding="md">
        <details class="flex flex-col gap-4">
          <summary class="text-sm font-medium text-text-primary cursor-pointer select-none mb-2">
            SEO設定（任意）
          </summary>
          <div class="flex flex-col gap-4">
            <div>
              <label for="meta_title" class="block text-sm font-medium text-text-primary mb-1.5">
                メタタイトル
              </label>
              <input
                type="text"
                id="meta_title"
                name="meta_title"
                maxlength="200"
                value={article.seo_metadata?.meta_title || ''}
                class="w-full px-3 py-2.5 text-base text-text-primary bg-surface-base border border-border-default rounded-sm min-h-[44px] focus:outline-2 focus:outline-accent-blue focus:border-accent-blue"
              />
            </div>
            <div>
              <label for="meta_description" class="block text-sm font-medium text-text-primary mb-1.5">
                メタディスクリプション
              </label>
              <textarea
                id="meta_description"
                name="meta_description"
                maxlength="500"
                rows="2"
                class="w-full px-3 py-2.5 text-base text-text-primary bg-surface-base border border-border-default rounded-sm focus:outline-2 focus:outline-accent-blue focus:border-accent-blue resize-y"
              >{article.seo_metadata?.meta_description || ''}</textarea>
            </div>
            <div>
              <label for="og_image_url" class="block text-sm font-medium text-text-primary mb-1.5">
                OGP画像URL
              </label>
              <input
                type="url"
                id="og_image_url"
                name="og_image_url"
                value={article.seo_metadata?.og_image_url || ''}
                class="w-full px-3 py-2.5 text-base text-text-primary bg-surface-base border border-border-default rounded-sm min-h-[44px] focus:outline-2 focus:outline-accent-blue focus:border-accent-blue"
              />
            </div>
          </div>
        </details>
      </Card>

      <!-- Actions -->
      <div class="flex items-center gap-3 flex-wrap">
        <Button type="submit" variant="accent" id="save-btn">
          更新を保存
        </Button>
        {article.status !== 'published' && (
          <Button type="button" variant="primary" onclick="publishArticle()">
            公開する
          </Button>
        )}
        {article.status === 'published' && (
          <Button type="button" variant="secondary" onclick="unpublishArticle()">
            非公開にする
          </Button>
        )}
        <a href="/dashboard/articles" class="text-sm text-text-secondary hover:text-text-primary transition-colors no-underline ml-auto">
          ← 記事一覧に戻る
        </a>
      </div>
    </form>
  </div>
</DashboardLayout>

<script>
  const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';

  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('article-form')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      await submitArticle({});
    });
  });

  async function submitArticle(extra: Record<string, unknown>) {
    const form = document.getElementById('article-form') as HTMLFormElement;
    const articleId = form.dataset.articleId;

    const title = (document.getElementById('title') as HTMLInputElement).value.trim();
    const slug = (document.getElementById('slug') as HTMLInputElement).value.trim();
    const excerpt = (document.getElementById('excerpt') as HTMLTextAreaElement).value.trim();
    const coverImageUrl = (document.getElementById('cover_image_url') as HTMLInputElement).value.trim();

    const tiptap = document.querySelector('.tiptap');
    const content = tiptap ? tiptap.innerHTML : '';

    if (!title) {
      alert('タイトルを入力してください');
      return;
    }

    const body: Record<string, unknown> = { title, content, ...extra };
    if (slug) body.slug = slug;
    if (excerpt) body.excerpt = excerpt;
    if (coverImageUrl) body.cover_image_url = coverImageUrl;

    const metaTitle = (document.getElementById('meta_title') as HTMLInputElement)?.value.trim();
    const metaDescription = (document.getElementById('meta_description') as HTMLTextAreaElement)?.value.trim();
    const ogImageUrl = (document.getElementById('og_image_url') as HTMLInputElement)?.value.trim();
    if (metaTitle || metaDescription || ogImageUrl) {
      body.seo_metadata = {
        meta_title: metaTitle || undefined,
        meta_description: metaDescription || undefined,
        og_image_url: ogImageUrl || undefined,
      };
    }

    try {
      const token = document.cookie
        .split('; ')
        .find(row => row.startsWith('sb-token='))
        ?.split('=')[1];

      const res = await fetch(`${API_BASE}/api/articles/${articleId}`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`,
        },
        body: JSON.stringify(body),
      });

      if (res.ok) {
        alert('記事を更新しました');
        window.location.reload();
      } else {
        const err = await res.json();
        alert(`エラー: ${err.error?.message || '更新に失敗しました'}`);
      }
    } catch {
      alert('ネットワークエラーが発生しました');
    }
  }

  async function publishArticle() {
    await submitArticle({ published_at: new Date().toISOString() });
  }

  async function unpublishArticle() {
    if (!confirm('記事を非公開にしますか？')) return;
    await submitArticle({ published_at: null });
  }
</script>
